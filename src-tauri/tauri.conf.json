{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spengler Digital CAD",
  "version": "0.1.0",
  "identifier": "ch.spengler-digital.cad",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Spengler Digital CAD",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["German"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBOTI1NDFGOEJBQkFCQjEKUldTeHE2dUxIMVNTcWtrS3Z3bUNiL1p1WWEwSmJKbGlSSERnQjRjU3BZQ2huOE15Q2JVaDhSY3IK",
      "endpoints": ["https://github.com/Mikesch15/Spengler-Digital-CAD/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
